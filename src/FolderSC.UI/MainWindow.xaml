<Window x:Class="FolderSC.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:FolderSC.UI.ViewModels"
        mc:Ignorable="d"
        Title="FolderSC — Folder Sync Companion"
        Width="780" Height="720"
        MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Source Selection -->
                <RowDefinition Height="Auto" /> <!-- Path Preview Card -->
                <RowDefinition Height="Auto" /> <!-- Output Configuration -->
                <RowDefinition Height="Auto" /> <!-- Action & Notifications -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FolderSC"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" />
                    <Border Background="#1C382A"
                            BorderBrush="#2E7D32"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0 • Handheld Companion"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Effortlessly replicate savegame folder paths from PC to handhelds (ROG Ally, Legion Go) for Syncthing."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 2. Source Path Selection Card -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Source Save Folder (PC)"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Select or paste the directory on this PC, or drag &amp; drop any folder into the window:"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />

                        <Button Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseSourceFolderCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Real-Time Path Translation Preview Card -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="2. Target Folder Translation (ROG Ally Preview)"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <!-- Dynamic Variable Tag -->
                        <Border Grid.Column="1"
                                Background="#102A43"
                                BorderBrush="#243B53"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                Visibility="{Binding HasDynamicVariables, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="✨ Cross-Device Ready (%VAR%)"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#62B0E8" />
                        </Border>
                    </Grid>

                    <TextBlock Text="This is the exact directory hierarchy that will be created on the destination machine:"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,10" />

                    <!-- Preview Field with Copy Button -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding NormalizedPreviewPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="#1C1C1C"
                                 Foreground="#62B0E8"
                                 FontFamily="Consolas"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />

                        <Button Grid.Column="1"
                                Content="Copy"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyNormalizedPathCommand}"
                                ToolTip="Copy translated path to clipboard" />
                    </Grid>

                    <CheckBox IsChecked="{Binding UseDynamicVariables}"
                              Content="Translate user profile paths to dynamic variables (%LOCALAPPDATA%, %APPDATA%, %USERPROFILE%)" />
                </StackPanel>
            </Border>

            <!-- 4. Output Configuration Card -->
            <Border Grid.Row="3"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="3. Output Setup"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Output Format Options -->
                    <TextBlock Text="Generated Format:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton Content="Standalone Executable (.exe)"
                                     IsChecked="{Binding SelectedFormat, Converter={StaticResource FormatToBoolConverter}, ConverterParameter=Executable}"
                                     GroupName="OutputFormat"
                                     Margin="0,0,24,0"
                                     ToolTip="Double-clickable program with native Windows notification dialog. Zero external dependencies." />

                        <RadioButton Content="Windows Batch Script (.bat)"
                                     IsChecked="{Binding SelectedFormat, Converter={StaticResource FormatToBoolConverter}, ConverterParameter=Batch}"
                                     GroupName="OutputFormat"
                                     ToolTip="Lightweight, transparent Windows command script." />
                    </StackPanel>

                    <!-- Destination Directory -->
                    <TextBlock Text="Destination Output Directory:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />

                        <Button Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseOutputDirectoryCommand}" />
                    </Grid>

                    <!-- Optional Settings Grid -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Custom File Name -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Custom Filename (Optional):"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding CustomOutputFileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Game / App Title (Optional):"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding OpenExplorerOnExecution}"
                              Content="Open target folder in File Explorer upon execution on destination device"
                              Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 5. Action & Notifications -->
            <StackPanel Grid.Row="4">
                <!-- Primary Action Button -->
                <Button Content="Generate Script / Executable"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ProcessCommand}"
                        HorizontalAlignment="Stretch"
                        Height="48"
                        Margin="0,0,0,14" />

                <!-- Success Alert Banner -->
                <Border Background="{StaticResource SuccessBackgroundBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="✔ Generation Successful!"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessTextBrush}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Open File Location"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenOutputFolderCommand}"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Error Alert Banner -->
                <Border Background="{StaticResource ErrorBackgroundBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="✖ Generation Failed"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ErrorTextBrush}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
